<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
    <div class="auth-card form-card">

        <div class="auth-header">
            <h2 class="auth-title">Report an Item</h2>
            <p class="auth-subtitle">Laundry mixup? Post it here!</p>
        </div>

        <form action="/listings" method="POST" class="auth-form needs-validation" enctype="multipart/form-data" novalidate>

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-tag"></i></span>
                    <input
                        type="text"
                        id="title"
                        name="listing[title]"
                        class="form-control"
                        placeholder="e.g. Lost: Blue Hoodie/Found: Blue Denim"
                        required
                    >
                    <div class="invalid-feedback">Please enter a title.</div>
                </div>
            </div>

          
            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    id="description"
                    name="listing[description]"
                    class="form-control"
                    rows="4"
                    placeholder="Add details or click Generate to auto-fill..."
                ></textarea>
                <button type="button" class="btn generate-btn mt-2" id="generateBtn">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Generate Description
                </button>
            </div>

            <!-- Image -->
            <div class="mb-4">
                <label for="image" class="form-label">Upload Image</label>
                <input
                    type="file"
                    id="image"
                    name="image"
                    class="form-control"
                    accept="image/*"
                >
            </div>

            <!-- Buttons -->
            <div class="form-btn-group">
                <button type="submit" class="btn auth-btn">
                    <i class="fa-solid fa-paper-plane"></i> Post
                </button>
                <a href="/listings" class="btn cancel-btn">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

<script>
document.getElementById("generateBtn").addEventListener("click", async function() {
    const title = document.getElementById("title").value.trim();
    
    if(!title) {
        alert("Enter the title first!");
        return;
    }
    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating...';
    this.disabled = true;
    
    try {
        const response = await fetch("/listings/generate-description", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title })
        });
        
        const data = await response.json();
        
        if(data.description) {
            document.getElementById("description").value = data.description;
        }
        
    } catch(e) {
        alert("Something went wrong, try again!");
    }
    
    // Button reset
    this.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Generate Description';
    this.disabled = false;
});
</script>